# TMDB API
TMDB_API_KEY=tmdb_key_here
SECRET_KEY=change-me-in-dev

# MySQL Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=db_user
MYSQL_PASSWORD=password_here
MYSQL_DATABASE=movie_recommender

# Set to true for managed MySQL (TiDB Cloud, etc.). Local dev can leave this off.
MYSQL_SSL=false
# Optional: path to a specific CA bundle. Defaults to certifi's bundle.
# MYSQL_SSL_CA=/path/to/ca.pem

# Comma-separated browser origins allowed to call the API when the frontend is
# hosted separately. Leave empty for same-origin only (the default deployment).
# CORS_ORIGINS=https://your-frontend.example.com

# Set to true to expose DB host/user and raw errors on /api/health.
HEALTH_DETAILS=false
